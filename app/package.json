{
  "name": "fseda-api",
  "version": "1.0.0",
  "private": true,
  "description": "API für die Lernplattform fseda.online (Kurse, Lektionen, Login, Fortschritt)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "STATIC_DIR=../frontend/dist DATA_DIR=./data-dev COOKIE_SECURE=0 node --disable-warning=ExperimentalWarning server.js",
    "set-role": "node --disable-warning=ExperimentalWarning scripts/set-role.js",
    "seed-demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
  }
}
